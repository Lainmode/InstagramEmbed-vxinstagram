@using InstagramEmbed.Application.Services
@inject InstanceSettings Instance
@{ ViewData["Title"] = Instance.Name; }
<main class="container py-5">
    <h1>@Instance.Name</h1>
    <p>Share a public Instagram post or reel with a preview in chat.</p>
    <p>Replace <code>www.instagram.com</code> with <code>@(new Uri(Instance.BaseUrl).Authority)</code>.</p>
    <p>For one album item, append its number: <code>@Instance.BaseUrl/p/CODE/2/</code>.</p>
    <p>Stories, private posts and short share links are not supported. Open a share link in Instagram first, then copy the post or reel URL.</p>
    <footer class="mt-5 text-secondary">
        Personal instance based on <a href="https://github.com/Lainmode/InstagramEmbed-vxinstagram">InstagramEmbed by Lainmode</a>.
        <a href="https://github.com/b4shful/vxinstagram">Fork source and license</a>.
    </footer>
</main>
