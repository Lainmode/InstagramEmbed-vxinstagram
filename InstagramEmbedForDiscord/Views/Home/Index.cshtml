@using InstagramEmbed.Application.Models
@using InstagramEmbed.Application.Services
@inject InstanceSettings Instance
@model EmbedPage
@{
    Layout = null;
    var selected = Model.Order ?? 0;
    var media = Model.Post.Media[selected];
    var original = $"https://www.instagram.com/{Model.Kind}/{Model.Id}/";
    var mediaBase = $"{Instance.BaseUrl}/media/{Model.Kind}/{Model.Id}";
    var contentUrl = $"{mediaBase}/{selected}";
    var title = Instance.ShowDetails ? Model.Post.AuthorUsername : Instance.Name;
    var caption = Instance.ShowDetails ? Model.Post.Caption : null;
    var files = Model.Order.HasValue ? Model.Post.Media.Skip(selected).Take(1) : Model.Post.Media;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - @Instance.Name</title>
    <meta property="og:title" content="@title" />
    <meta property="og:site_name" content="@Instance.Name" />
    <meta property="og:url" content="@original" />
    <link rel="canonical" href="@original" />
    <link rel="icon" href="/icon.svg" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    @if (!string.IsNullOrEmpty(caption))
    {
        <meta property="og:description" content="@caption" />
    }
    @if (media.MediaType == "video")
    {
        <meta property="og:type" content="video.other" />
        <meta property="og:video" content="@contentUrl" />
        <meta property="og:video:secure_url" content="@contentUrl" />
        <meta property="og:video:type" content="video/mp4" />
        <meta name="twitter:card" content="player" />
        <meta name="twitter:player:stream" content="@contentUrl" />
        <meta name="twitter:player:stream:content_type" content="video/mp4" />
        @if (media.Width > 0 && media.Height > 0)
        {
            <meta property="og:video:width" content="@media.Width" />
            <meta property="og:video:height" content="@media.Height" />
        }
    }
    else
    {
        <meta name="twitter:card" content="summary_large_image" />
    }
    @if (!string.IsNullOrEmpty(media.ThumbnailUrl))
    {
        <meta property="og:image" content="@(contentUrl)?thumbnail=true" />
        <meta name="twitter:image" content="@(contentUrl)?thumbnail=true" />
    }
    <link rel="alternate" type="application/json+oembed"
          href="@(Instance.BaseUrl)/oembed?username=@Uri.EscapeDataString(title)" />
    @if (!Model.Order.HasValue && Model.Post.Media.Count > 1)
    {
        <link rel="alternate" type="application/activity+json"
              href="@(Instance.BaseUrl)/users/instagram/statuses/@(Model.Kind).@(Model.Id)" />
    }
</head>
<body class="bg-dark text-light">
    <main class="container py-4">
        <h1 class="h4">@Instance.Name</h1>
        <a href="@original">View original on Instagram</a>
        @if (!string.IsNullOrEmpty(caption)) { <p class="mt-3">@caption</p> }
        <div class="row g-4 mt-2">
        @foreach (var item in files)
        {
            var index = Model.Post.Media.IndexOf(item);
            <div class="col-12 col-md-6">
                @if (item.MediaType == "video")
                {
                    <video controls preload="none" class="w-100" style="max-height:80vh;object-fit:contain"
                           poster="@(mediaBase)/@index?thumbnail=true" src="@(mediaBase)/@index"></video>
                }
                else
                {
                    <img class="w-100" style="max-height:80vh;object-fit:contain" src="@(mediaBase)/@index" alt="Instagram post" />
                }
            </div>
        }
        </div>
    </main>
</body>
</html>
